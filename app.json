{
  "expo": {
    "name": "ZannyPay",
    "slug": "zannypay",
    "scheme": "zannypay",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D2261"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zannypay.app",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "ZannyPay uses your camera to scan a Pay QR code."
      }
    },
    "android": {
      "package": "com.zannypay.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D2261"
      },
      "permissions": ["CAMERA"]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0D2261"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ZannyPay uses your camera to scan a Pay QR code."
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    }
  }
}
