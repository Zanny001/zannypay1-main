{
  "expo": {
    "name": "ZannyPay",
    "slug": "zannypay",
    "scheme": "zannypay",
    "version": "1.1.2",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#031311"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zannypay.app",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "ZannyPay uses your camera to scan a Pay QR code."
      }
    },
    "android": {
      "package": "com.zannypay.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#031311"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#00D99A"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ZannyPay uses your camera to scan a Pay QR code."
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "34764801-f60a-4128-b8a0-393da61c1d35"
      }
    }
  }
}
